bin/
obj/
.vscode/
*.user
*.suo
*.cache
*.log
CosmicMachine_Backup/
DiagnosticReports/
.DS_Store

# Calibration Presets v0.1: local, per-machine/per-user calibration presets
# (Audio/CalibrationPresetStore.cs) - runtime user data, not source. Built-in
# defaults are seeded automatically on first run if this file doesn't exist.
CosmicEngineApp/Config/calibration-presets.json

# VisionBoard: local reference video assets (1.2GB) used for the video-atoms
# planning pass - reference/runtime data, not source, not needed to build or
# run the engine.
VisionBoard/
# VideoCurationOutput: local video-atom curation review tooling + generated
# previews/thumbnails (1.1GB) - runtime/generated review data, not source.
VideoCurationOutput/

# Media Console: commit the tool's source + curation state, but not its
# self-packaged archive, timestamped runtime backups, or the demo recording -
# those are regenerable artifacts, consistent with how DiagnosticReports and
# other generated content are excluded.
MediaConsole/*.zip
MediaConsole/**/backups/
MediaConsole/**/demo/
MediaConsole/**/generated_media/
